<Window x:Class="batteryQI.Views.CustomMessageBoxYesNo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:batteryQI.Views"
        WindowStyle="None" ResizeMode="NoResize"
        Height="250" Width="400"
        SizeToContent="WidthAndHeight" Background="White"
        WindowStartupLocation="CenterScreen">

    <Border Background="#cfd5e5" CornerRadius="10" BorderThickness="2" BorderBrush="#ebedf3" Padding="10">
        <Grid Margin="5,0,5,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 메시지 내용 -->
            <TextBlock Grid.Row="0" x:Name="MessageText" Style="{StaticResource titleText}" Text="💡 안내문" HorizontalAlignment="Center" FontSize="25" Margin="0 0 0 10" FontWeight="SemiBold"/>

            <Border Grid.Row="1" CornerRadius="10" Margin="5 0" Height="130">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="White" Offset="0"/>
                        <GradientStop Color="White" Offset="1.2"/>
                    </LinearGradientBrush>
                </Border.Background>
                <!-- 버튼 컨테이너 -->
                <TextBox Name="Message" Text="기본" Margin="12" FontSize="15"/>

            </Border>

            <Button Grid.Row="2" Style="{StaticResource imageSectionButton}" x:Name="OkButton" Content="확인" FontSize="18" Height="NaN" Width="100" HorizontalAlignment="Right" Margin="0,10,5,0"/>
            <Button Grid.Row="2" Style="{StaticResource imageSectionButton}" x:Name="CancelButton" Content="취소" FontSize="18" Height="NaN" Width="100" HorizontalAlignment="Left" Margin="5,10,0,0"/>
        </Grid>
    </Border>
</Window>
