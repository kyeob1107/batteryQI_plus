<UserControl x:Class="batteryQI_plus.Views.UserControls.AnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:batteryQI_plus.Extensions"
             xmlns:vm="clr-namespace:batteryQI_plus.ViewModels"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             >
    <UserControl.DataContext>
        <Binding Path="AnalysisViewModel" Source="{StaticResource Locator}" />
    </UserControl.DataContext>

    <Border Background="#F5F5F5" Padding="10">
        <Grid>
            <!-- Row Definitions for Layout -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 상단 필터 및 버튼 -->
                <RowDefinition Height="*"/>
                <!-- 하단 탭 컨트롤 -->
            </Grid.RowDefinitions>

            <!-- 상단: 필터 및 버튼 -->
            <Border Grid.Row="0" Background="#E6E6FA" CornerRadius="5" Padding="10" Margin="0 0 0 10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- 필터 영역 -->
                        <ColumnDefinition Width="4*"/>
                        <!-- id 검색 영역 -->
                        <ColumnDefinition Width="*"/>
                        <!-- 버튼 영역 -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 필터 -->
                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- 그외 설정 관련 필터 영역 -->
                                <ColumnDefinition Width="*"/>
                                <!-- 상태 & 라인 영역 -->
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <!--<StackPanel Orientation="Horizontal">-->
                                    <!-- 시작 날짜 시간 -->
                                    <!--<ComboBox Width="150" SelectedItem="{Binding SelectedUsage}" ItemsSource="{Binding UsageList}" Margin="0,0,10,0"/>
                                    <TextBox Text="바인딩으로 수정필요"/>
                                    <TextBlock Text=" ~ "/>-->
                                    <!-- 끝 날짜 시간 -->
                                    <!--<ComboBox Width="150" SelectedItem="{Binding SelectedUsage}" ItemsSource="{Binding UsageList}" Margin="0,0,10,0"/>
                                    <TextBox Text="바인딩으로 수정필요"/>
                                </StackPanel>-->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="시작:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}" Width="120"
                                                DisplayDateStart="{Binding DateRangeStart}" DisplayDateEnd="{Binding DateRangeEnd}"/>
                                    <TextBox Text="{Binding StartTime, Mode=TwoWay}" Width="80" Margin="5,0,0,0" VerticalContentAlignment="Center"/>

                                    <TextBlock Text="끝:" VerticalAlignment="Center" Margin="20,0,5,0"/>
                                    <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}" Width="120"
                                                DisplayDateStart="{Binding DateRangeStart}" DisplayDateEnd="{Binding DateRangeEnd}"/>
                                    <TextBox Text="{Binding EndTime, Mode=TwoWay}" Width="80" Margin="5,0,0,0" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <UniformGrid Rows="1">
                                    <Expander Header="사용처" IsExpanded="False" Margin="0,10,0,0" x:Name="UsageExpander">
                                        <Expander.Content>
                                            <Popup IsOpen="{Binding IsExpanded, ElementName=UsageExpander}" 
                                                   Placement="Bottom" PlacementTarget="{Binding ElementName=UsageExpander}">
                                                <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="5">
                                                    <ItemsControl ItemsSource="{Binding UsageItems}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </Popup>
                                        </Expander.Content>
                                    </Expander>
                                    <Expander Header="발주처" IsExpanded="False" Margin="0,10,0,0" x:Name="BuyerExpander">
                                        <Expander.Content>
                                            <Popup IsOpen="{Binding IsExpanded, ElementName=BuyerExpander}" 
               Placement="Bottom" PlacementTarget="{Binding ElementName=BuyerExpander}">
                                                <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="5">
                                                    <ItemsControl ItemsSource="{Binding BuyerItems}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </Popup>
                                        </Expander.Content>
                                    </Expander>
                                    <Expander Header="배터리 타입" IsExpanded="False" Margin="0,10,0,0" x:Name="BatteryTypeExpander">
                                        <Expander.Content>
                                            <Popup IsOpen="{Binding IsExpanded, ElementName=BatteryTypeExpander}" 
Placement="Bottom" PlacementTarget="{Binding ElementName=BatteryTypeExpander}">
                                                <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="5">
                                                    <ItemsControl ItemsSource="{Binding BatteryTypeItems}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </Popup>
                                        </Expander.Content>
                                    </Expander>
                                    <Expander Header="배터리 형태" IsExpanded="False" Margin="0,10,0,0" x:Name="BatteryShapeExpander">
                                        <Expander.Content>
                                            <Popup IsOpen="{Binding IsExpanded, ElementName=BatteryShapeExpander}" 
                                                   Placement="Bottom" PlacementTarget="{Binding ElementName=BatteryShapeExpander}">
                                                <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="5">
                                                    <ItemsControl ItemsSource="{Binding BatteryShapeItems}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </Popup>
                                        </Expander.Content>
                                    </Expander>
                                </UniformGrid>

                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Expander Header="상태" IsExpanded="False" Margin="0,10,0,0" x:Name="StatusExpander">
                                    <Expander.Content>
                                        <Popup IsOpen="{Binding IsExpanded, ElementName=StatusExpander}" 
Placement="Bottom" PlacementTarget="{Binding ElementName=StatusExpander}">
                                            <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="5">
                                                <ItemsControl ItemsSource="{Binding StatusItems}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </Popup>
                                    </Expander.Content>
                                </Expander>
                                <Expander Header="생산 라인" IsExpanded="False" Margin="0,10,0,0" x:Name="ProductionLineExpander">
                                    <Expander.Content>
                                        <Popup IsOpen="{Binding IsExpanded, ElementName=ProductionLineExpander}" 
Placement="Bottom" PlacementTarget="{Binding ElementName=ProductionLineExpander}">
                                            <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="5">
                                                <ItemsControl ItemsSource="{Binding ProductionLineItems}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </Popup>
                                    </Expander.Content>
                                </Expander>
                            </StackPanel>
                            
                        </Grid>
                    </StackPanel>
                    <!-- id 검색 영역 -->
                    <StackPanel Orientation="Vertical" Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="배터리 id:" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,5,0"/>
                        <TextBox Text="{Binding BatteryId}" PreviewTextInput="TextBox_PreviewTextInput"/>
                    </StackPanel>
                    <!-- 조회 버튼 -->
                    <Button Grid.Column="2" Content="조회" Width="60" Height="60"
                            Command="{Binding SearchCommand}" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <!-- 하단: 탭 컨트롤 -->
            <TabControl Grid.Row="1" Background="#FFFFFF" BorderThickness="1">
                <!-- 타임차트 탭 -->
                <TabItem Header="타임차트">
                    <Border Background="#FFFFFF" Padding="10">
                        <lvc:CartesianChart Series="{Binding SeriesCollectionTimeChart}" LegendLocation="Right">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Title="시간" LabelFormatter="{Binding DateTimeFormatter}"/>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis Title="불량률 (%)" LabelFormatter="{Binding YFormatter}"/>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                    </Border>
                </TabItem>

                <!-- 불량비율 탭 -->
                <TabItem Header="불량비율">
                    <Border Background="#FFFFFF" Padding="10">
                        <!-- 그래프 Placeholder -->
                        <!--<TextBlock Text="불량비율 그래프 영역 (바인딩 필요)" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>-->
                        <lvc:PieChart LegendLocation="Right" 
                                      Hoverable="True" 
                                      DataTooltip="{x:Null}"
                                      Series="{Binding SeriesCollectionPie}"
                                      DataClick="Chart_OnDataClick">
                            <!--<lvc:PieChart.DataClickCommand>
                                <Binding Path="Chart_OnDataClickCommand" />
                            </lvc:PieChart.DataClickCommand>-->
                        </lvc:PieChart>
                    </Border>
                </TabItem>

                <!-- 유형별 수 탭 -->
                <TabItem Header="유형별 수">
                    <Border Background="#FFFFFF" Padding="10">
                        <lvc:CartesianChart Series="{Binding SeriesCollectionColumn}" LegendLocation="Right">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Title="Lines" Labels="{Binding LabelsColumn}"></lvc:Axis>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis Title="Number" LabelFormatter="{Binding FormatterColumn}"></lvc:Axis>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                    </Border>
                </TabItem>

                <!-- 데이터 조회 탭 -->
                <TabItem Header="데이터 조회">
                    <Border Background="#FFFFFF" Padding="10">
                        <!-- 데이터 테이블 Placeholder -->
                        <DataGrid ItemsSource="{Binding QueryResultsTable}" AutoGenerateColumns="True"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>
