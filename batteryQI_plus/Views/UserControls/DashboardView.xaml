<UserControl x:Class="batteryQI_plus.Views.UserControls.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:batteryQI_plus.ViewModels"
             >
    <!-- DataContext 설정 -->
    <UserControl.DataContext>
        <Binding Path="DashboardViewModel" Source="{StaticResource Locator}" />
    </UserControl.DataContext>

    <Border Background="White" Padding="10">
        <Grid>
            <!-- Row Definitions for 3:1:2 Layout -->
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <!-- 단위시간 검사 모니터링 -->
            <Border Grid.Row="0" Background="#7163ba" CornerRadius="10" Padding="10" Margin="0 0 0 10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Text="단위시간 검사 모니터링" FontSize="18" FontWeight="Bold" Foreground="#333333" Margin="0 0 0 10"/>

                    <!-- TabControl -->
                    <TabControl Grid.Row="1" Background="#FFFFFF" BorderThickness="0">
                        <!-- 전체 탭 -->
                        <TabItem Header="전체">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text ="{Binding LogContent[0]}" 
                                           TextWrapping="Wrap" FontSize="14" 
                                           Foreground="#333333"/>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Line1 탭 -->
                        <TabItem Header="Line1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text ="{Binding LogContent[1]}" 
                                           TextWrapping="Wrap" FontSize="14" 
                                           Foreground="#333333"/>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Line2 탭 -->
                        <TabItem Header="Line2">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text ="{Binding LogContent[2]}" 
                                           TextWrapping="Wrap" FontSize="14" 
                                           Foreground="#333333"/>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Line3 탭 -->
                        <TabItem Header="Line3">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding LogContent[3]}" 
                                           TextWrapping="Wrap" FontSize="14" 
                                           Foreground="#333333"/>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <!-- 실시간 불량률 차트 -->
            <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="10" Padding="10" Margin="0 0 0 10">
                <TextBlock Text="실시간 불량률 차트 (공간 확보)" FontSize="18" FontWeight="Bold" Foreground="#333333"/>
                <!-- 차트 공간 확보 -->
                <!--<Border Background="#E6E6FA" CornerRadius="5" Margin="0,10,0,0" Height="100"/>-->
            </Border>

            <!-- 검사 진행률 & 단위시간 검사 합계 -->
            <Border Grid.Row="2" Background="#7163ba" CornerRadius="10" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Text="검사 진행률 &amp; 단위시간 검사 합계" FontSize="18" FontWeight="Bold" Foreground="#333333" Margin="0 0 0 10"/>

                    <!-- TabControl (구조 동일) -->
                    <TabControl Grid.Row="1" Background="#FFFFFF" BorderThickness="0">
                        <!-- 전체 탭 -->
                        <TabItem Header="전체">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding TotalLogContent[0]}" 
                                           TextWrapping="Wrap" FontSize="14" 
                                           Foreground="#333333"/>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Line1 탭 -->
                        <TabItem Header="Line1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding TotalLogContent[1]}"
                                           TextWrapping="Wrap" FontSize="14" 
                                           Foreground="#333333"/>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Line2 탭 -->
                        <TabItem Header="Line2">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding TotalLogContent[2]}" 
                                           TextWrapping="Wrap" FontSize="14" 
                                           Foreground="#333333"/>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Line3 탭 -->
                        <TabItem Header="Line3">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding TotalLogContent[3]}" 
                                           TextWrapping="Wrap" FontSize="14" 
                                           Foreground="#333333"/>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
