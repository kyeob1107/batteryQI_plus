<Window x:Class="batteryQI_plus.Views.EditSettingView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:batteryQI_plus.Views"
        mc:Ignorable="d"
        Title="EditSettingWindow"
        Height="750" Width="500">

    <Window.DataContext>
        <Binding Path="SettingViewModel" Source="{StaticResource Locator}" />
    </Window.DataContext>

    <Border Background="#cfd5e5" CornerRadius="10" BorderThickness="2" BorderBrush="#ebedf3" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Style="{StaticResource titleText}" Text="설정 편집" HorizontalAlignment="Center" FontSize="30" Margin="0 15" FontWeight="SemiBold"/>


            <Border Grid.Row="1" CornerRadius="10" Margin="20 0 20 10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="White" Offset="0"/>
                        <GradientStop Color="White" Offset="1.2"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <!--<Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>-->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <!--<Border BorderBrush="Gray" BorderThickness="0,3,0,0" Margin="25,0" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Stretch"/>

                    <ComboBox Name="Employees" Grid.Row="0" Grid.Column="0" Margin="20 0 40 0" Height="32" Width="140"
                              Text="직원" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" IsEditable="true" IsReadOnly="true" IsDropDownOpen="False" StaysOpenOnEdit="False">
                        <ComboBoxItem>
                            <TextBlock Text="sf_zone" FontSize="18" VerticalAlignment="Center" TextAlignment="Left"/>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <TextBlock Text="Shin" FontSize="18" VerticalAlignment="Center" TextAlignment="Left"/>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <TextBlock Text="Kim" FontSize="18" VerticalAlignment="Center" TextAlignment="Left"/>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <TextBlock Text="Park" FontSize="18" VerticalAlignment="Center" TextAlignment="Left"/>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <TextBlock Text="Choi" FontSize="18" VerticalAlignment="Center" TextAlignment="Left"/>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <TextBlock Text="Lim" FontSize="18" VerticalAlignment="Center" TextAlignment="Left"/>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <TextBlock Text="Han" FontSize="18" VerticalAlignment="Center" TextAlignment="Left"/>
                        </ComboBoxItem>
                    </ComboBox>

                    <ComboBox Name="LineInCharge" Grid.Row="0" Grid.Column="1" Margin="30 20 20 20" Height="30" Width="150">
                        <ComboBoxItem>
                            <TextBlock Text="관리자 직책" FontSize="18" VerticalAlignment="Center" TextAlignment="Left"/>
                        </ComboBoxItem>
                        <ComboBoxItem IsSelected="True">
                            <TextBlock Text="생산라인1" FontSize="18" VerticalAlignment="Center" TextAlignment="Left"/>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <TextBlock Text="생산라인2" FontSize="18" VerticalAlignment="Center" TextAlignment="Left"/>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <TextBlock Text="생산라인3" FontSize="18" VerticalAlignment="Center" TextAlignment="Left"/>
                        </ComboBoxItem>
                    </ComboBox>-->

                    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>


                        <TextBlock Grid.Row="0" Grid.Column="0" Text="생산라인" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Left" Margin="30 0 40 0"/>
                        <ComboBox Name="LineIdBox" Grid.Row="0" Grid.Column="1" Margin="30 0 20 0" Height="30" Width="150"
                                  ItemsSource="{Binding Path=LineIdList}" FontSize="18" VerticalAlignment="Center"
                                  SelectedItem="{Binding SelectedLineId}"/>

                        <Border BorderBrush="Gray" BorderThickness="0,3,0,0" Margin="25,0" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Stretch"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="배터리 사용처" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Left" Margin="30 0 40 0"/>
                        <ComboBox Name="UsageNameBox" Grid.Row="1" Grid.Column="1" Margin="30 0 20 0" Height="30" Width="150"
                                  ItemsSource="{Binding Path=UsageNameList}" FontSize="18" VerticalAlignment="Center"
                                  SelectedItem="{Binding SelectedLineSetting.UsageName}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="배터리 타입" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Left" Margin="30 0 40 0"/>
                        <ComboBox Name="BatteryTypeBox" Grid.Row="2" Grid.Column="1" Margin="30 0 20 0" Height="30" Width="150"
                                  ItemsSource="{Binding Path=BatteryTypeList}" FontSize="18" VerticalAlignment="Center"
                                  SelectedItem="{Binding SelectedLineSetting.BatteryType}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="배터리 형태" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Left" Margin="30 0 40 0"/>
                        <ComboBox Name="BatteryShapeBox" Grid.Row="3" Grid.Column="1" Margin="30 0 20 0" Height="30" Width="150"
                                  ItemsSource="{Binding Path=BatteryShapeList}" FontSize="18" VerticalAlignment="Center"
                                  SelectedItem="{Binding SelectedLineSetting.BatteryShape}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="발주처" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Left" Margin="30 0 40 0"/>
                        <ComboBox Name="BuyerNameBox" Grid.Row="4" Grid.Column="1" Margin="30 0 20 0" Height="30" Width="150"
                                  ItemsSource="{Binding Path=BuyerDataDic}" FontSize="18" VerticalAlignment="Center"
                                  DisplayMemberPath="Value"
                                  SelectedItem="{Binding SelectedLineSetting.BuyerData}"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="할당량" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Left" Margin="30 0 40 0"/>
                        <TextBox Name="QuotaText" Grid.Row="5" Grid.Column="1" Width="150" Margin="30 0 20 0" Background="#FFE5E5E5"
                                 FontSize="20" VerticalAlignment="Center" TextAlignment="Left"
                                 TextChanged="OnlyEnterInteger_TextChanged"
                                 Text="{Binding SelectedLineSetting.Quota}"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="마감기한:" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Left" Margin="30 0 40 0"/>
                        <DatePicker Name="DeadlineStartPicker" Grid.Row="6" Grid.Column="1" Background="#FFE5E5E5" Width="120" Margin="-260 0 0 0" 
                                    FontSize="15" VerticalAlignment="Center"
                                    SelectedDate="{Binding SelectedLineSetting.DeadlineStart}"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="~" FontSize="20" VerticalAlignment="Center" TextAlignment="Center" Width="30" Margin="-110,0,0,0"/>
                        <DatePicker Name="DeadlineEndPicker" Grid.Row="6" Grid.Column="1" Background="#FFE5E5E5" Width="120" Margin="40,0,0,0"
                                    FontSize="15" VerticalAlignment="Center"
                                    SelectedDate="{Binding SelectedLineSetting.DeadlineEnd}"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Style="{StaticResource imageSectionButton}" Grid.Column="0" Content="취소" FontSize="22" FontWeight="SemiBold" Height="50" Width="150" Margin="0, 0, 47, 0" Click="CloseButtonClick" />
                <Button Style="{StaticResource imageSectionButton}" Grid.Column="1" Content="저장" FontSize="22" FontWeight="SemiBold" Height="50" Width="150" Margin="47, 0, 0, 0" 
                        Command="{Binding SaveLineSettingButtonClickCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
